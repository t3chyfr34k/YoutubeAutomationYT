<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="YouTubeAutomation.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:YouTubeAutomation.Mobile"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="#FFFFFF"
       Shell.TabBarForegroundColor="#4B91F5"
       Shell.TabBarTitleColor="#4B91F5"
       Shell.TabBarUnselectedColor="#7B8798">
  <TabBar>
    <ShellContent Title="Home" Route="home" ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent Title="Discover" Route="discover" ContentTemplate="{DataTemplate local:DiscoverPage}" />
    <ShellContent Title="Insights" Route="insights" ContentTemplate="{DataTemplate local:InsightsPage}" />
    <ShellContent Title="Activity" Route="activity" ContentTemplate="{DataTemplate local:ActivityPage}" />
    <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
  </TabBar>
</Shell>
